{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "mcpApiKey": {
      "value": "${MCP_API_KEY}"
    },
    "existingStorageAccountName": {
      "value": "${AZURE_STORAGE_ACCOUNT_NAME}"
    },
    "existingStorageAccountKey": {
      "value": "${AZURE_STORAGE_ACCOUNT_KEY}"
    },
    "lifecyclePolicyMode": {
      "value": "${LIFECYCLE_POLICY_MODE=none}"
    },
    "disabledTools": {
      "value": "${DISABLED_TOOLS=}"
    },
    "enableOtel": {
      "value": "${ENABLE_OTEL=false}"
    },
    "otelCollectorImage": {
      "value": "${OTEL_COLLECTOR_IMAGE=}"
    },
    "logRetentionDays": {
      "value": "${LOG_RETENTION_DAYS=30}"
    },
    "otelTelemetryLevel": {
      "value": "${OTEL_TELEMETRY_LEVEL}"
    },
    "otelLogMinSeverity": {
      "value": "${OTEL_LOG_MIN_SEVERITY}"
    }
  }
}
