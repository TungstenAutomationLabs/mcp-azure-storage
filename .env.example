# =============================================================================
# MCP Azure Storage Server -- Environment Configuration Reference
# =============================================================================
#
# Copy this file to `.env` and fill in your values. All settings below are
# documented with their defaults. Commented-out lines show the default value
# or are optional -- uncomment and change as needed.
#
# ASCII only in this file -- no em-dashes, smart quotes, or non-ASCII chars.

# =============================================================================
# Server
# =============================================================================

# HTTP port the Express server listens on.
PORT=3000

# API key for client authentication. Clients must present this via
# X-API-Key header or Authorization: Bearer <key>. Leave unset to
# disable authentication (NOT recommended for production).
MCP_API_KEY=your-secret-api-key-here

# Enable CORS for browser-based MCP clients (MCP Inspector, web chat).
# Set to "false" if the server is only consumed by non-browser clients
# behind a reverse proxy.
CORS_ENABLED=true

# Node.js environment. Set to "production" for deployed environments.
# NODE_ENV=production

# =============================================================================
# Azure Deployment (used by deploy_to_azure.ps1)
# =============================================================================
#
# These configure the Azure deployment target. All are optional if you have
# already run `azd env set` manually, but putting them here means the deploy
# script handles everything from a single file.

# azd environment name (creates resource group as rg-<name>)
# AZURE_ENV_NAME=my-environment

# Azure subscription ID
# AZURE_SUBSCRIPTION_ID=

# Azure region
# AZURE_LOCATION=uksouth

# Override default resource group name (default: rg-<AZURE_ENV_NAME>)
# AZURE_RESOURCE_GROUP=

# =============================================================================
# Azure Container Registry
# =============================================================================

# ACR name for scripts/push-to-acr.ps1 and scripts/setup-acr.ps1.
# Not used by the deploy script directly (azd manages its own ACR).
ACR_NAME=<your-acr-name>

# =============================================================================
# Azure Storage (required)
# =============================================================================

# Storage account name and shared key. At least one authentication method
# is required: either set the key here, or enable managed identity below.
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=youraccountkey

# Managed Identity (optional -- default: false)
# Set to "true" to use DefaultAzureCredential for data operations instead of
# the shared key. Requires RBAC role assignments on the storage account
# (Storage Blob/Queue/Table Data Contributor). The shared key is still used
# for SAS token generation when available.
AZURE_USE_MANAGED_IDENTITY=false

# =============================================================================
# Azure Storage Service URL Overrides (for Azurite / local emulators)
# =============================================================================
#
# When set, SDK clients use these URLs instead of constructing from the
# account name. Only needed for local development with Azurite.
#
# AZURE_BLOB_SERVICE_URL=http://127.0.0.1:10000/devstoreaccount1
# AZURE_QUEUE_SERVICE_URL=http://127.0.0.1:10001/devstoreaccount1
# AZURE_TABLE_SERVICE_URL=http://127.0.0.1:10002/devstoreaccount1
# AZURE_FILE_SERVICE_URL=

# =============================================================================
# SAS Token Defaults
# =============================================================================

# Default SAS token lifetime in hours.
SAS_EXPIRY_HOURS=24

# Default SAS permission string (r=read, l=list, w=write, d=delete).
SAS_DEFAULT_PERMISSIONS=rl

# Maximum allowed SAS token lifetime in minutes. Requests for expiryMinutes
# (or expiryHours converted to minutes) exceeding this ceiling receive a
# structured "invalid" error. Default: 1440 (24 hours).
SAS_MAX_EXPIRY_MINUTES=1440

# SAS protocol for generated tokens.
#   "https"       -- (default) HTTPS only; recommended for production.
#   "https,http"  -- Allow both HTTPS and HTTP; required for Azurite / local
#                    emulator which serves over plain HTTP.
SAS_PROTOCOL=https

# =============================================================================
# Rate Limiting
# =============================================================================

# Time window in seconds for rate limiting.
RATE_LIMIT_WINDOW_SECONDS=900

# Maximum MCP JSON-RPC requests (/mcp) per window per identity.
RATE_LIMIT_MCP_MAX=3000

# Maximum upload requests (/upload) per window per identity.
RATE_LIMIT_UPLOAD_MAX=600

# Legacy rate-limit vars (used when new-style vars are unset):
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX_REQUESTS=300

# Number of trusted proxy hops for X-Forwarded-For resolution.
# Set to 1 for Azure Container Apps ingress alone.
# Set to 2 if behind both Azure Front Door and Container Apps.
TRUST_PROXY_HOPS=1

# =============================================================================
# Session Management (stateless mode -- retained for backward compatibility)
# =============================================================================

# Maximum concurrent sessions. In stateless mode (v1.3.0+), sessions are
# per-request so this is effectively unused, but kept for reference.
MAX_SESSIONS=100
SESSION_RETRY_AFTER_SECONDS=30

# =============================================================================
# Upload and Body Size Limits
# =============================================================================

# Hard byte limit for streaming multipart uploads via POST /upload.
# Files exceeding this limit are rejected with HTTP 413 and code "too_large".
# Default: 5368709120 (5 GiB). Set lower for tighter control.
MAX_UPLOAD_BYTES=5368709120

# Hard byte limit for JSON request bodies on POST /mcp (base64 payloads).
# Controls express.json({ limit }). Default: 52428800 (50 MiB).
MAX_JSON_BODY_BYTES=52428800

# =============================================================================
# Queue Lease Limits
# =============================================================================

# Maximum allowed visibility timeout (lease duration) in seconds for
# queue-update-message and queue-renew-lease. Default: 3600 (1 hour).
# Azure supports up to 604800 (7 days), but this server-side cap prevents
# accidentally setting very long leases that block message redelivery.
MAX_QUEUE_VISIBILITY_SECONDS=3600

# =============================================================================
# Tool Gating
# =============================================================================

# Comma-separated list of tool names to disable at runtime.
# Disabled tools are omitted from tools/list and return a structured
# "forbidden" error (code: "forbidden", data.reason: "disabled_tool")
# when invoked. Values are case-insensitive.
# DISABLED_TOOLS=blob-delete,fileshare-delete-share,table-delete,queue-delete

# =============================================================================
# OpenTelemetry Monitoring
# =============================================================================
#
# OTel monitoring is OFF by default. To enable:
#   - For Azure deployments: set ENABLE_OTEL=true here OR pass -EnableOTel
#     to deploy_to_azure.ps1. Both paths are fully equivalent.
#   - For local development: set OTEL_EXPORTER_OTLP_ENDPOINT to a local
#     collector URL (e.g. http://localhost:4318).
#
# When neither ENABLE_OTEL nor OTEL_EXPORTER_OTLP_ENDPOINT is set, the
# instrumentation.cjs activation guard exits immediately with zero overhead.

# Master switch for Azure deployments. When true, the deploy script provisions
# an OTel Collector sidecar + Application Insights and sets
# OTEL_EXPORTER_OTLP_ENDPOINT automatically via the Bicep template.
# ENABLE_OTEL=false

# OTLP endpoint for the OTel Collector. This is the activation guard --
# if empty, instrumentation is skipped entirely.
# For local development with a local collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# For Azure deployments, set automatically by the Bicep template.

# OTel service name reported as a resource attribute.
# Default: mcp-azure-storage
# OTEL_SERVICE_NAME=mcp-azure-storage

# Replica name for multi-replica attribution. Set automatically by
# Azure Container Apps (CONTAINER_APP_REPLICA_NAME env var). For local
# development, defaults to "local".
# CONTAINER_APP_REPLICA_NAME=local

# Telemetry level controls sampling, metric export interval, and log filtering.
#   off      -- same as not setting the endpoint (zero overhead)
#   basic    -- 10% trace sampling, WARN+ logs, 60s metrics
#   detailed -- 100% trace sampling, INFO+ logs, 15s metrics
#   full     -- 100% sampling, all log levels, 5s metrics
# Default: basic (when OTEL_EXPORTER_OTLP_ENDPOINT is set)
# OTEL_TELEMETRY_LEVEL=basic

# Minimum log severity for OTel log filtering (both collector and app-side).
# Values: 1=TRACE, 5=DEBUG, 9=INFO, 13=WARN, 17=ERROR, 21=FATAL
# Default: determined by OTEL_TELEMETRY_LEVEL preset
# OTEL_LOG_MIN_SEVERITY=9

# Fine-grained overrides (override the level preset defaults):
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRICS_EXPORT_INTERVAL_MS=60000

# PII scrubbing for OTel telemetry (default: true).
# When enabled, blob names, container names, and URLs in span attributes
# are SHA-256 hashed to prevent sensitive file names leaking into traces.
# Set to "false" to disable (e.g. for local debugging).
# OTEL_SCRUB_PII=true

# SDK debug logging (extremely verbose, for diagnosing export failures):
# OTEL_LOG_LEVEL=debug

# Required for Azure Monitor (delta temporality for cumulative metrics).
# Set automatically by the deploy script and Bicep template.
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta

# =============================================================================
# Application Insights (for the OTel Collector, not the app directly)
# =============================================================================
#
# The connection string is used by the OTel Collector sidecar, not by the
# MCP server application itself. For Azure deployments, this is provisioned
# and injected automatically by the Bicep template.
#
# For local development with a local collector pointing to App Insights:
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# =============================================================================
# Deployment Script Options (deploy_to_azure.ps1 parameters)
# =============================================================================
#
# These are NOT read from .env by the app at runtime. They are either
# script parameters or synced to azd env by the deploy script.
#
# Log Analytics / App Insights data retention in days (30-730).
# Passed as -LogRetentionDays to the deploy script. Default: 30.
# Longer retention costs more.
#
# Lifecycle policy for new storage accounts (has no effect on BYOSA):
# Passed as -LifecyclePolicy to the deploy script.
#   none     -- (default) No lifecycle rules. All blobs stay in Hot tier.
#   one-way  -- Cold after 15d, Archive after 90d. Manual rehydration needed.
#   smart    -- Cool after 30d inactivity, auto-reheat on access.
